<% content_for :title, "My Schedule | Online School" %><div class="page-heading"><div><p class="eyebrow">Teacher / Calendar</p><h1>My schedule</h1><p class="muted">Upcoming meetings for your assigned classes.</p></div></div><div class="table-panel"><table><thead><tr><th>Date</th><th>Status</th><th>Time</th><th>Class</th><th>Location</th></tr></thead><tbody><% @schedules.each do |schedule| %><tr><td><%= schedule.schedule_date.strftime("%b %-d, %Y") %></td><td><span class="schedule-status schedule-status-<%= schedule_status_class(schedule) %>"><%= schedule_status(schedule) %></span></td><td><%= schedule.start_time.strftime("%H:%M") %> - <%= schedule.end_time.strftime("%H:%M") %></td><td><%= schedule.classroom.name %></td><td><%= schedule.room.presence || "Online" %></td></tr><% end %></tbody></table><%= render "shared/empty_state", title: "No schedules yet", description: "Your assigned class meetings will appear here." if @schedules.empty? %></div>
