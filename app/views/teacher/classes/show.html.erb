<% content_for :title, @classroom.name %><div class="page-heading"><div><p class="eyebrow">Teacher / Class</p><h1><%= @classroom.name %></h1><p class="muted"><%= @classroom.course.name %></p></div></div><div class="detail-grid"><section class="content-panel"><p class="eyebrow">Class details</p><dl class="detail-list"><dt>Students</dt><dd><%= @classroom.students.size %></dd><dt>Status</dt><dd><%= @classroom.status.humanize %></dd></dl></section><section class="content-panel"><p class="eyebrow">Class schedule</p><% if @classroom.schedules.any? %><ul class="clean-list"><% @classroom.schedules.each do |schedule| %><li><strong><%= schedule.schedule_date.strftime("%b %-d") %></strong><span><%= schedule.start_time.strftime("%H:%M") %> - <%= schedule.end_time.strftime("%H:%M") %></span></li><% end %></ul><% else %><%= render "shared/empty_state", title: "No schedules yet" %><% end %></section></div><section class="content-panel"><p class="eyebrow">Enrolled students</p><% if @classroom.students.any? %><ul class="clean-list"><% @classroom.students.each do |student| %><li><strong><%= link_to student.name, teacher_student_path(student), class: "text-link" %></strong><span><%= student.status.humanize %></span></li><% end %></ul><% else %><%= render "shared/empty_state", title: "No students enrolled" %><% end %></section>
