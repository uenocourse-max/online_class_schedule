<%= render "shared/form_errors", object: student_progress %><%= form_with model: [:teacher, student_progress], class: "stacked-form resource-form" do |form| %><div><%= form.label :student_id, "Student" %><%= form.collection_select :student_id, students, :id, :name, { prompt: "Choose a student" }, required: true %></div><div><%= form.label :classroom_id, "Class" %><%= form.collection_select :classroom_id, classrooms, :id, :name, { prompt: "Choose a class" }, required: true %></div><div><%= form.label :progress_date %><%= form.date_field :progress_date, required: true %></div><div><%= form.label :score %><%= form.number_field :score, min: 0, max: 100, step: 0.01, required: true %></div><div><%= form.label :status %><%= form.select :status, StudentProgress::STATUSES.map { |status| [status.humanize, status] }, { prompt: "Choose a status" }, required: true %></div><div><%= form.label :note %><%= form.text_area :note, rows: 5 %></div><%= form.submit class: "button button-primary" %><% end %>
