<% content_for :title, "Student Progress | Online School" %><div class="page-heading"><div><p class="eyebrow">Teacher / Student care</p><h1>Student progress</h1><p class="muted">Your progress history across assigned classes.</p></div><%= link_to "Add progress", new_teacher_student_progress_path, class: "button button-primary" %></div><div class="table-panel"><table><thead><tr><th>Date</th><th>Student</th><th>Class</th><th>Score</th><th>Status</th><th></th></tr></thead><tbody><% @progresses.each do |progress| %><tr><td><%= progress.progress_date.strftime("%b %-d, %Y") %></td><td><%= progress.student.name %></td><td><%= progress.classroom.name %></td><td><strong><%= progress.score.to_i %></strong></td><td><span class="status-badge"><%= progress.status.humanize %></span></td><td><%= link_to "View", teacher_student_progress_path(progress), class: "text-link" %></td></tr><% end %></tbody></table><%= render "shared/empty_state", title: "No progress records yet", description: "Create a progress entry for one of your students." if @progresses.empty? %></div>
