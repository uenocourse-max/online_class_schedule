<% content_for :title, @student.name %><div class="page-heading"><div><p class="eyebrow">Teacher / Student</p><h1><%= @student.name %></h1><p class="muted"><%= @student.user.email %></p></div><%= link_to "Add progress", new_teacher_student_progress_path, class: "button button-primary" %></div><div class="detail-grid"><section class="content-panel"><p class="eyebrow">Teaching context</p><dl class="detail-list"><dt>Status</dt><dd><%= @student.status.humanize %></dd><dt>Phone</dt><dd><%= @student.phone.presence || "Not provided" %></dd><dt>Classes</dt><dd><%= @classrooms.map(&:name).join(", ") %></dd></dl></section><section class="content-panel"><p class="eyebrow">Progress history</p><% if @progresses.any? %><ul class="clean-list"><% @progresses.each do |progress| %><li><strong><%= progress.progress_date.strftime("%b %-d") %> · <%= progress.score.to_i %></strong><span><%= progress.status.humanize %></span></li><% end %></ul><% else %><%= render "shared/empty_state", title: "No progress yet" %><% end %></section></div>
