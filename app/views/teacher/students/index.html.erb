<% content_for :title, "My Students | Online School" %><div class="page-heading"><div><p class="eyebrow">Teacher / Learners</p><h1>My students</h1><p class="muted">Students enrolled in your assigned classes.</p></div></div><div class="table-panel"><table><thead><tr><th>Name</th><th>Email</th><th>Classes</th><th>Status</th><th></th></tr></thead><tbody><% @students.each do |student| %><tr><td><strong><%= student.name %></strong></td><td><%= student.user.email %></td><td><%= student.classrooms.where(teacher_id: current_teacher.id).map(&:name).join(", ") %></td><td><span class="status-badge"><%= student.status.humanize %></span></td><td><%= link_to "View", teacher_student_path(student), class: "text-link" %></td></tr><% end %></tbody></table><%= render "shared/empty_state", title: "No students assigned", description: "Students appear when they enroll in your classes." if @students.empty? %></div>
