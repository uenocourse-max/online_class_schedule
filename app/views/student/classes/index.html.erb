<% content_for :title, "My Classes | Online School" %><div class="page-heading"><div><p class="eyebrow">Student / Learning</p><h1>My classes</h1><p class="muted">Your active enrollments and teachers.</p></div></div><div class="table-panel"><table><thead><tr><th>Class</th><th>Course</th><th>Teacher</th><th>Status</th><th></th></tr></thead><tbody><% @classrooms.each do |classroom| %><tr><td><strong><%= classroom.name %></strong></td><td><%= classroom.course.name %></td><td><%= classroom.teacher.name %></td><td><span class="status-badge"><%= classroom.status.humanize %></span></td><td><%= link_to "View", student_class_path(classroom), class: "text-link" %></td></tr><% end %></tbody></table><%= render "shared/empty_state", title: "No classes enrolled", description: "Your active classes will appear here." if @classrooms.empty? %></div>
