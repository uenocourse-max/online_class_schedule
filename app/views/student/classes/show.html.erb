<% content_for :title, @classroom.name %><div class="page-heading"><div><p class="eyebrow">Student / Class</p><h1><%= @classroom.name %></h1><p class="muted"><%= @classroom.course.name %> · Teacher <%= @classroom.teacher.name %></p></div></div><section class="content-panel"><p class="eyebrow">Upcoming meetings</p><% if @classroom.schedules.any? %><ul class="clean-list"><% @classroom.schedules.each do |schedule| %><li><strong><%= schedule.schedule_date.strftime("%b %-d, %Y") %></strong><span><%= schedule.start_time.strftime("%H:%M") %> - <%= schedule.end_time.strftime("%H:%M") %> · <%= schedule.room.presence || "Online" %></span></li><% end %></ul><% else %><%= render "shared/empty_state", title: "No schedules yet" %><% end %></section>
