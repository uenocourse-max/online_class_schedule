<% content_for :title, "Edit Profile | Online School" %><div class="page-heading"><div><p class="eyebrow">Student / Profile</p><h1>Edit profile</h1></div></div><%= render "shared/form_errors", object: @student %><%= form_with model: @student, url: student_profile_path, method: :patch, class: "stacked-form resource-form" do |form| %><div><%= form.label :phone %><%= form.telephone_field :phone %></div><div><%= form.label :birth_date %><%= form.date_field :birth_date %></div><div><%= form.label :gender %><%= form.text_field :gender %></div><div><%= form.label :address %><%= form.text_area :address, rows: 4 %></div><%= form.submit "Update profile", class: "button button-primary" %><% end %>
