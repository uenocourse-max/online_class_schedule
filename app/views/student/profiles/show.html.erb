<% content_for :title, "My Profile | Online School" %><div class="page-heading"><div><p class="eyebrow">Student / Profile</p><h1>My profile</h1><p class="muted">Your account and personal information.</p></div><%= link_to "Edit profile", edit_student_profile_path, class: "button button-secondary" %></div><section class="content-panel"><dl class="detail-list"><dt>Name</dt><dd><%= @student.name %></dd><dt>Email</dt><dd><%= @student.user.email %></dd><dt>Phone</dt><dd><%= @student.phone.presence || "Not provided" %></dd><dt>Birth date</dt><dd><%= @student.birth_date&.strftime("%B %-d, %Y") || "Not provided" %></dd><dt>Gender</dt><dd><%= @student.gender.presence || "Not provided" %></dd><dt>Address</dt><dd><%= @student.address.presence || "Not provided" %></dd></dl></section>
