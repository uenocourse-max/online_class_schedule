<% content_for :title, "Progress Record | Online School" %><div class="page-heading"><div><p class="eyebrow">Student / Progress</p><h1><%= @progress.student.name %></h1><p class="muted"><%= @progress.progress_date.strftime("%B %-d, %Y") %> · <%= @progress.classroom.name %></p></div></div><section class="content-panel"><dl class="detail-list"><dt>Score</dt><dd><%= @progress.score.to_i %></dd><dt>Status</dt><dd><%= @progress.status.humanize %></dd><dt>Teacher</dt><dd><%= @progress.teacher.name %></dd><dt>Teacher note</dt><dd><%= @progress.note.presence || "No note" %></dd></dl></section><%= link_to "Back to progress", student_progress_index_path, class: "text-link back-link" %>
