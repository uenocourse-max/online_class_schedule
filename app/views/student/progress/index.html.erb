<% content_for :title, "My Progress | Online School" %><div class="page-heading"><div><p class="eyebrow">Student / Progress</p><h1>My progress</h1><p class="muted">A dated history of your learning.</p></div><span class="status-badge">Average: <%= @average_score ? number_with_precision(@average_score, precision: 1) : "--" %></span></div><div class="table-panel"><table><thead><tr><th>Date</th><th>Class</th><th>Score</th><th>Status</th><th>Teacher</th><th></th></tr></thead><tbody><% @progresses.each do |progress| %><tr><td><%= progress.progress_date.strftime("%b %-d, %Y") %></td><td><%= progress.classroom.name %></td><td><strong><%= progress.score.to_i %></strong></td><td><span class="status-badge"><%= progress.status.humanize %></span></td><td><%= progress.teacher.name %></td><td><%= link_to "View", student_progress_path(progress), class: "text-link" %></td></tr><% end %></tbody></table><%= render "shared/empty_state", title: "No progress recorded", description: "Your teacher's progress records will appear here." if @progresses.empty? %></div>
