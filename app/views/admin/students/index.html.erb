<% content_for :title, "Students | Online School" %>
<div class="page-heading"><div><p class="eyebrow">Admin / People</p><h1>Students</h1><p class="muted">Manage learner profiles and enrollment context.</p></div><%= link_to "Add student", new_admin_student_path, class: "button button-primary" %></div>
<%= form_with url: admin_students_path, method: :get, class: "filter-bar" do |form| %><%= form.search_field :query, value: params[:query], placeholder: "Search by name", aria: { label: "Search students" } %><%= form.select :status, options_for_select([["All statuses", ""]] + Student::STATUSES.map { |status| [status.humanize, status] }, params[:status]) %><%= form.submit "Filter", class: "button button-secondary" %><% end %>
<div class="table-panel"><table><thead><tr><th>Name</th><th>Email</th><th>Classes</th><th>Status</th><th></th></tr></thead><tbody><% @students.each do |student| %><tr><td><strong><%= student.name %></strong></td><td><%= student.user.email %></td><td><%= student.classrooms.map(&:name).join(", ").presence || "-" %></td><td><span class="status-badge"><%= student.status.humanize %></span></td><td><%= link_to "View", admin_student_path(student), class: "text-link" %></td></tr><% end %></tbody></table><%= render "shared/empty_state", title: "No students found", description: "Create a student or adjust your filters." if @students.empty? %></div>
