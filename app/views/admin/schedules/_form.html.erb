<%= render "shared/form_errors", object: schedule %><%= form_with model: [:admin, schedule], class: "stacked-form resource-form" do |form| %><div><%= form.label :classroom_id, "Class" %><%= form.collection_select :classroom_id, classrooms, :id, :name, { prompt: "Choose a class" }, required: true %></div><div><%= form.label :teacher_id, "Teacher" %><%= form.collection_select :teacher_id, teachers, :id, :name, { prompt: "Choose a teacher" }, required: true %></div><div><%= form.label :schedule_date %><%= form.date_field :schedule_date, required: true %></div><div><%= form.label :start_time %><%= form.time_field :start_time, required: true %></div><div><%= form.label :end_time %><%= form.time_field :end_time, required: true %></div><div><%= form.label :room %><%= form.text_field :room %></div><div><%= form.label :meeting_link %><%= form.url_field :meeting_link %></div><%= form.submit class: "button button-primary" %><% end %>
