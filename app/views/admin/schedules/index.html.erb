<% content_for :title, "Schedules | Online School" %><div class="page-heading"><div><p class="eyebrow">Admin / Calendar</p><h1>Schedules</h1><p class="muted">Coordinate classes across the school day.</p></div><%= link_to "Add schedule", new_admin_schedule_path, class: "button button-primary" %></div><div class="table-panel"><table><thead><tr><th>Date</th><th>Status</th><th>Time</th><th>Class</th><th>Teacher</th><th>Location</th><th></th></tr></thead><tbody><% @schedules.each do |schedule| %><tr><td><%= schedule.schedule_date.strftime("%b %-d, %Y") %></td><td><span class="schedule-status schedule-status-<%= schedule_status_class(schedule) %>"><%= schedule_status(schedule) %></span></td><td><%= schedule.start_time.strftime("%H:%M") %> - <%= schedule.end_time.strftime("%H:%M") %></td><td><%= schedule.classroom.name %></td><td><%= schedule.teacher.name %></td><td><%= schedule.room.presence || "Online" %></td><td><%= link_to "Edit", edit_admin_schedule_path(schedule), class: "text-link" %></td></tr><% end %></tbody></table><%= render "shared/empty_state", title: "No schedules yet", description: "Add the first class meeting to build the calendar." if @schedules.empty? %></div>
