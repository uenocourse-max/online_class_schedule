<% content_for :title, "Schedule | Online School" %><div class="page-heading"><div><p class="eyebrow">Admin / Schedule</p><h1><%= @schedule.classroom.name %></h1><p class="muted"><%= @schedule.schedule_date.strftime("%A, %B %-d, %Y") %></p></div><%= link_to "Edit", edit_admin_schedule_path(@schedule), class: "button button-secondary" %></div><section class="content-panel"><dl class="detail-list"><dt>Time</dt><dd><%= @schedule.start_time.strftime("%H:%M") %> - <%= @schedule.end_time.strftime("%H:%M") %></dd><dt>Teacher</dt><dd><%= @schedule.teacher.name %></dd><dt>Location</dt><dd><%= @schedule.room.presence || "Online" %></dd></dl></section>
