<% content_for :title, "Progress Record | Online School" %><div class="page-heading"><div><p class="eyebrow">Admin / Progress</p><h1><%= @progress.student.name %></h1><p class="muted"><%= @progress.progress_date.strftime("%B %-d, %Y") %> · <%= @progress.classroom.name %></p></div><%= link_to "Edit", edit_admin_student_progress_path(@progress), class: "button button-secondary" %></div><section class="content-panel"><dl class="detail-list"><dt>Score</dt><dd><%= number_with_precision(@progress.score, precision: 0) %></dd><dt>Status</dt><dd><%= @progress.status.humanize %></dd><dt>Teacher</dt><dd><%= @progress.teacher.name %></dd><dt>Note</dt><dd><%= @progress.note.presence || "No note" %></dd></dl></section>
