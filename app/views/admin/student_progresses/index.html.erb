<% content_for :title, "Progress | Online School" %><div class="page-heading"><div><p class="eyebrow">Admin / Student care</p><h1>Progress</h1><p class="muted">Review dated learning history across the school.</p></div><%= link_to "Add progress", new_admin_student_progress_path, class: "button button-primary" %></div><div class="table-panel"><table><thead><tr><th>Date</th><th>Student</th><th>Class</th><th>Score</th><th>Status</th><th>Teacher</th><th></th></tr></thead><tbody><% @progresses.each do |progress| %><tr><td><%= progress.progress_date.strftime("%b %-d, %Y") %></td><td><%= progress.student.name %></td><td><%= progress.classroom.name %></td><td><strong><%= number_with_precision(progress.score, precision: 0) %></strong></td><td><span class="status-badge"><%= progress.status.humanize %></span></td><td><%= progress.teacher.name %></td><td><%= link_to "View", admin_student_progress_path(progress), class: "text-link" %></td></tr><% end %></tbody></table><%= render "shared/empty_state", title: "No progress records yet", description: "Progress entries will build the learning history." if @progresses.empty? %></div>
