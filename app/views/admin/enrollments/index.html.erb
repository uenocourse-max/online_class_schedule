<% content_for :title, "Enrollments | Online School" %><div class="page-heading"><div><p class="eyebrow">Admin / Teaching</p><h1>Enrollments</h1><p class="muted">Place learners in their active classes.</p></div></div><section class="content-panel form-panel"><p class="eyebrow">New enrollment</p><%= form_with model: [:admin, Enrollment.new], class: "inline-form" do |form| %><%= form.collection_select :student_id, @students, :id, :name, { prompt: "Student" }, required: true %><%= form.collection_select :classroom_id, @classrooms, :id, :name, { prompt: "Class" }, required: true %><%= form.date_field :enrolled_at, value: Date.current, required: true %><%= form.hidden_field :status, value: "active" %><%= form.submit "Enroll", class: "button button-primary" %><% end %></section><div class="table-panel"><table><thead><tr><th>Student</th><th>Class</th><th>Enrolled</th><th>Status</th><th></th></tr></thead><tbody><% @enrollments.each do |enrollment| %><tr><td><%= enrollment.student.name %></td><td><%= enrollment.classroom.name %></td><td><%= enrollment.enrolled_at.strftime("%b %-d, %Y") %></td><td><span class="status-badge"><%= enrollment.status.humanize %></span></td><td><%= button_to "Drop", admin_enrollment_path(enrollment), method: :delete, class: "text-button" if enrollment.status == "active" %></td></tr><% end %></tbody></table><%= render "shared/empty_state", title: "No enrollments yet", description: "Use the form above to enroll a student." if @enrollments.empty? %></div>
