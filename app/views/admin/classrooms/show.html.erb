<% content_for :title, @classroom.name %><div class="page-heading"><div><p class="eyebrow">Admin / Class</p><h1><%= @classroom.name %></h1><p class="muted"><%= @classroom.course.name %> · <%= @classroom.teacher.name %></p></div><%= link_to "Edit", edit_admin_classroom_path(@classroom), class: "button button-secondary" %></div><div class="detail-grid"><section class="content-panel"><p class="eyebrow">Class details</p><dl class="detail-list"><dt>Status</dt><dd><%= @classroom.status.humanize %></dd><dt>Teacher</dt><dd><%= @classroom.teacher.name %></dd><dt>Course</dt><dd><%= @classroom.course.name %></dd></dl></section><section class="content-panel"><p class="eyebrow">Students</p><% if @classroom.students.any? %><ul class="clean-list"><% @classroom.students.each do |student| %><li><strong><%= student.name %></strong><span><%= student.status.humanize %></span></li><% end %></ul><% else %><%= render "shared/empty_state", title: "No students enrolled" %><% end %></section></div><%= link_to "Back to classes", admin_classrooms_path, class: "text-link back-link" %>
