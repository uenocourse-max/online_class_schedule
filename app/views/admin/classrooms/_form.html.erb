<%= render "shared/form_errors", object: classroom %><%= form_with model: [:admin, classroom], class: "stacked-form resource-form" do |form| %><div><%= form.label :name %><%= form.text_field :name, required: true %></div><div><%= form.label :course_id, "Course" %><%= form.collection_select :course_id, courses, :id, :name, { prompt: "Choose a course" }, required: true %></div><div><%= form.label :teacher_id, "Teacher" %><%= form.collection_select :teacher_id, teachers, :id, :name, { prompt: "Choose a teacher" }, required: true %></div><div><%= form.label :status %><%= form.select :status, Classroom::STATUSES.map { |status| [status.humanize, status] } %></div><div><%= form.label :description %><%= form.text_area :description, rows: 4 %></div><%= form.submit class: "button button-primary" %><% end %>
