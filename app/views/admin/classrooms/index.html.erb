<% content_for :title, "Classes | Online School" %><div class="page-heading"><div><p class="eyebrow">Admin / Teaching</p><h1>Classes</h1><p class="muted">Connect courses, teachers, and learners.</p></div><%= link_to "Add class", new_admin_classroom_path, class: "button button-primary" %></div><div class="table-panel"><table><thead><tr><th>Class</th><th>Course</th><th>Teacher</th><th>Students</th><th>Status</th><th></th></tr></thead><tbody><% @classrooms.each do |classroom| %><tr><td><strong><%= classroom.name %></strong></td><td><%= classroom.course.name %></td><td><%= classroom.teacher.name %></td><td><%= classroom.students.size %></td><td><span class="status-badge"><%= classroom.status.humanize %></span></td><td><%= link_to "View", admin_classroom_path(classroom), class: "text-link" %></td></tr><% end %></tbody></table><%= render "shared/empty_state", title: "No classes yet", description: "Create a class and assign a teacher and course." if @classrooms.empty? %></div>
