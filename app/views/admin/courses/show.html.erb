<% content_for :title, @course.name %><div class="page-heading"><div><p class="eyebrow">Admin / Course</p><h1><%= @course.name %></h1><p class="muted"><%= @course.description.presence || "No description" %></p></div><%= link_to "Edit", edit_admin_course_path(@course), class: "button button-secondary" %></div><section class="content-panel"><p class="eyebrow">Classes using this course</p><% if @course.classrooms.any? %><ul class="clean-list"><% @course.classrooms.each do |classroom| %><li><strong><%= link_to classroom.name, admin_classroom_path(classroom), class: "text-link" %></strong><span><%= classroom.teacher.name %></span></li><% end %></ul><% else %><%= render "shared/empty_state", title: "No classes yet" %><% end %></section><%= link_to "Back to courses", admin_courses_path, class: "text-link back-link" %>
