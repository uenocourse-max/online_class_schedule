<%= render "shared/form_errors", object: course %><%= form_with model: [:admin, course], class: "stacked-form resource-form" do |form| %><div><%= form.label :name %><%= form.text_field :name, required: true %></div><div><%= form.label :status %><%= form.select :status, Course::STATUSES.map { |status| [status.humanize, status] } %></div><div><%= form.label :description %><%= form.text_area :description, rows: 5 %></div><%= form.submit class: "button button-primary" %><% end %>
