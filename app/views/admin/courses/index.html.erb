<% content_for :title, "Courses | Online School" %><div class="page-heading"><div><p class="eyebrow">Admin / Curriculum</p><h1>Courses</h1><p class="muted">Keep the curriculum catalogue current.</p></div><%= link_to "Add course", new_admin_course_path, class: "button button-primary" %></div><div class="table-panel"><table><thead><tr><th>Course</th><th>Description</th><th>Classes</th><th>Status</th><th></th></tr></thead><tbody><% @courses.each do |course| %><tr><td><strong><%= course.name %></strong></td><td><%= truncate(course.description.to_s, length: 70).presence || "-" %></td><td><%= course.classrooms.size %></td><td><span class="status-badge"><%= course.status.humanize %></span></td><td><%= link_to "View", admin_course_path(course), class: "text-link" %></td></tr><% end %></tbody></table><%= render "shared/empty_state", title: "No courses yet", description: "Create the first course to begin building classes." if @courses.empty? %></div>
