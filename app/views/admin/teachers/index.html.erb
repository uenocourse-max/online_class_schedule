<% content_for :title, "Teachers | Online School" %><div class="page-heading"><div><p class="eyebrow">Admin / People</p><h1>Teachers</h1><p class="muted">Manage faculty profiles and assigned classes.</p></div><%= link_to "Add teacher", new_admin_teacher_path, class: "button button-primary" %></div><%= form_with url: admin_teachers_path, method: :get, class: "filter-bar" do |form| %><%= form.search_field :query, value: params[:query], placeholder: "Search by name", aria: { label: "Search teachers" } %><%= form.select :status, options_for_select([["All statuses", ""]] + Teacher::STATUSES.map { |status| [status.humanize, status] }, params[:status]) %><%= form.submit "Filter", class: "button button-secondary" %><% end %><div class="table-panel"><table><thead><tr><th>Name</th><th>Specialization</th><th>Classes</th><th>Status</th><th></th></tr></thead><tbody><% @teachers.each do |teacher| %><tr><td><strong><%= teacher.name %></strong><small><%= teacher.user.email %></small></td><td><%= teacher.specialization.presence || "-" %></td><td><%= teacher.classrooms.map(&:name).join(", ").presence || "-" %></td><td><span class="status-badge"><%= teacher.status.humanize %></span></td><td><%= link_to "View", admin_teacher_path(teacher), class: "text-link" %></td></tr><% end %></tbody></table><%= render "shared/empty_state", title: "No teachers found", description: "Create a teacher or adjust your filters." if @teachers.empty? %></div>
