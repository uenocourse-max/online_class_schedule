<% content_for :title, "Sign in | Online School" %>

<main class="auth-page">
  <section class="auth-panel" aria-labelledby="login-heading">
    <div class="brand-mark">OS</div>
    <p class="eyebrow">Online School</p>
    <h1 id="login-heading">Welcome back</h1>
    <p class="auth-intro">Sign in to continue to your school workspace.</p>

    <%= form_with url: login_path, method: :post, class: "stacked-form" do |form| %>
      <div>
        <%= form.label :email, "Email address" %>
        <%= form.email_field :email, required: true, autocomplete: "email", autofocus: true %>
      </div>
      <div>
        <%= form.label :password, "Password" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password" %>
      </div>
      <%= form.submit "Sign in", class: "button button-primary" %>
    <% end %>
  </section>
</main>
